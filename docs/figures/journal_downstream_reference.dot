digraph G {
graph [rankdir=LR, pack=true, packmode="array_u5", bgcolor="white", pad=0.3, nodesep=0.25, ranksep=0.55, fontname="DejaVu Sans", fontsize=21, labelloc=t, label="DOWNSTREAM | Actual scoring heads, shared modules and auxiliary path\nCurrent Large residual_feature, blend=0. Same [ID] = same parameter object"];
node [shape=box, style="rounded,filled", fillcolor="#eef5fc", color="#38658a", fontname="DejaVu Sans", fontsize=11, margin="0.13,0.09"];
edge [color="#30485f", arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];
subgraph cluster_feature {
sortv=99;
label="A. One shared feature backbone"; color="#2c6399"; fontsize=15; style=rounded;
img [sortv=0,label="Whole image 224x224"];
v [sortv=0,label="[V] CLIP ViT-L/14 visual\nTrainable, 768-D"];
r [sortv=0,label="[R] ResNet50 layer3\n1024 -> 256; 14 x 14; trainable"];
f [sortv=0,label="[F] SemanticStructureFusion"];
z [sortv=0,label="z: 256-D"];
l [sortv=0,label="[L] local_patch_proj\nConv1x1 256 -> 256"];
p0 [sortv=0,label="P0: raw local patch tokens\nSAME L weights in Q/Align calls"];
p [sortv=0,label="Real Prompt + [C] shared contexts"];
t [sortv=0,label="[T] Frozen CLIP text Transformer"];
u [sortv=0,label="[U] text_to_fused 768 -> 256"];
img -> v [label=""];
v -> f [label=""];
f -> z [label=""];
img -> r [label=""];
r -> f [label=""];
r -> l [label=""];
l -> p0 [label=""];
p -> t [label=""];
t -> u [label=""];
}
subgraph cluster_q {
sortv=98;
label="B. Quality scoring heads"; color="#1d8c78"; fontsize=15; style=rounded;
qz [sortv=0,label="Input z",fillcolor="#dcf3ed"];
qa [sortv=0,label="[QA] quality_adapter\nPQ weights initialize this MLP",fillcolor="#dcf3ed"];
a [sortv=0,label="a = normalized Adapter output",fillcolor="#dcf3ed"];
res [sortv=0,label="r = z + alpha ||z|| normalize(a)\nNorm detached; alpha learned, init 0.1",fillcolor="#dcf3ed"];
qg [sortv=0,label="[QG] global_quality_head\n256 -> 256 -> 128 -> 1 + sigmoid",fillcolor="#dcf3ed"];
qnss [sortv=0,label="Input image -> NSS6",fillcolor="#dcf3ed"];
n [sortv=0,label="[N] nss_proj 6 -> 256 -> 256",fillcolor="#dcf3ed"];
ql [sortv=0,label="Input P0 from SAME [L]",fillcolor="#dcf3ed"];
pqa [sortv=0,label="Pq = P0 + nss_proj(NSS)",fillcolor="#dcf3ed"];
qp [sortv=0,label="[QP] patch_quality_head\n256 -> 256 -> 1 + sigmoid",fillcolor="#dcf3ed"];
ng [sortv=0,label="[NG] nss_gate concat(Pq,NSS)\n262 -> 256 -> 1 -> softmax",fillcolor="#dcf3ed"];
pool [sortv=0,label="Weighted patch scores -> Qpatch",fillcolor="#dcf3ed"];
quality [sortv=0,label="Quality = beta Qpatch + (1-beta) Qglobal\nbeta = learned scalar sigmoid",fillcolor="#dcf3ed"];
diag [sortv=0,label="SAME [QG] also evaluates z and a\nDropout OFF for diagnostic calls\nNo separate quality_adapter_head",fillcolor="#ededed"];
qz -> qa [label=""];
qa -> a [label=""];
a -> res [label=""];
res -> qg [label=""];
qg -> quality [label=""];
qz -> res [label="z bypass"];
qnss -> n [label=""];
n -> pqa [label=""];
ql -> pqa [label=""];
pqa -> qp [label=""];
qp -> pool [label=""];
pool -> quality [label=""];
pqa -> ng [label=""];
ng -> pool [label=""];
qnss -> ng [label="raw NSS"];
qz -> diag [label=""];
a -> diag [label=""];
}
subgraph cluster_align {
sortv=97;
label="C. Align scoring heads | no NSS injection here"; color="#8552aa"; fontsize=15; style=rounded;
az [sortv=0,label="Input z",fillcolor="#eee4fa"];
ag [sortv=0,label="[AG] align_global_adapter",fillcolor="#eee4fa"];
at0 [sortv=0,label="Input U(text)",fillcolor="#eee4fa"];
at [sortv=0,label="[AT] align_text_adapter",fillcolor="#eee4fa"];
ap0 [sortv=0,label="Input P0 from SAME [L]",fillcolor="#eee4fa"];
ap [sortv=0,label="[AP] align_patch_adapter",fillcolor="#eee4fa"];
pairg [sortv=0,label="concat(v,u,abs(v-u))",fillcolor="#eee4fa"];
ahg [sortv=0,label="[AHG] align_global_head\n768 -> 256 -> 128 -> 1 + sigmoid",fillcolor="#eee4fa"];
xi [sortv=0,label="[XI] align_patch_img_proj\nLinear256 -> 256 + normalize",fillcolor="#eee4fa"];
xt [sortv=0,label="[XT] align_patch_txt_proj\nLinear256 -> 256 + normalize",fillcolor="#eee4fa"];
att [sortv=0,label="dot-product -> softmax weights",fillcolor="#eee4fa"];
ev [sortv=0,label="weighted sum of AP output -> e",fillcolor="#eee4fa"];
pairp [sortv=0,label="concat(e,u,abs(e-u))",fillcolor="#eee4fa"];
ahp [sortv=0,label="[AHP] align_patch_head\n768 -> 256 -> 128 -> 1 + sigmoid",fillcolor="#eee4fa"];
gin [sortv=0,label="concat(v,u,Aglobal,Apatch)",fillcolor="#eee4fa"];
gate [sortv=0,label="[G] align_gate\n514 -> 256 -> 1 + sigmoid -> g",fillcolor="#eee4fa"];
align [sortv=0,label="Align = g Aglobal + (1-g) Apatch",fillcolor="#eee4fa"];
az -> ag [label=""];
ag -> pairg [label=""];
pairg -> ahg [label=""];
at0 -> at [label=""];
at -> pairg [label=""];
ap0 -> ap [label=""];
ap -> xi [label=""];
xi -> att [label=""];
att -> ev [label=""];
ev -> pairp [label=""];
pairp -> ahp [label=""];
at -> xt [label=""];
xt -> att [label=""];
ap -> ev [label="values"];
at -> pairp [label=""];
ag -> gin [label=""];
at -> gin [label=""];
ahg -> gin [label=""];
ahp -> gin [label=""];
gin -> gate [label=""];
gate -> align [label=""];
ahg -> align [label=""];
ahp -> align [label=""];
}
subgraph cluster_bank {
sortv=96;
label="D. Auxiliary Quality text head | NOT a final-score head"; color="#cb8b27"; fontsize=15; style=rounded;
ba [sortv=0,label="Input a from SAME [QA]",fillcolor="#fff0cb"];
bm [sortv=0,label="[BQ.M] image_to_text\nLinear256 -> 768, no bias + normalize",fillcolor="#fff0cb"];
words [sortv=0,label="5 Quality phrases + class contexts\n[5,4,768], independent from [C]",fillcolor="#fff0cb"];
bt [sortv=0,label="SAME frozen Transformer [T]\nGradients pass to class contexts",fillcolor="#fff0cb"];
refs [sortv=0,label="5 normalized text references",fillcolor="#fff0cb"];
logits [sortv=0,label="image-text similarity / temperature\n5 logits -> soft-label CE, lambda=.005",fillcolor="#fff0cb"];
bnote [sortv=0,label="blend=0: no score mixing into Quality\nDoes NOT pass through U or text_projector",fillcolor="#fff0cb"];
ba -> bm [label=""];
bm -> logits [label=""];
words -> bt [label=""];
bt -> refs [label=""];
refs -> logits [label=""];
logits -> bnote [label="",style=dashed,color="#9b6b22"];
}
note [sortv=0,label="SHARING: AG / AT / AP are independent adapters; AHG / AHP independent heads.\nPQ, PI, PT and DQ, DI, DT are PRETRAINING modules, not downstream SimSiam heads.\nQG/QP/NG/N/L/XI/XT/AHG/AHP/G exist downstream but are reset in representation scope.\nLegacy s_final computed using fusion_logit, not supervised; no independent Final regression head.\nOptional text_gate / extra attention / V-Mamba / distribution / Align bank / HA-HE are OFF.",fillcolor="#ededed"];
}
